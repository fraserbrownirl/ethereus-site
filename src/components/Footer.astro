---
const REPO = "https://github.com/fraserbrownirl/ethereus";
---

<footer class="footer">
  <div class="wrap footer-inner">
    <div class="footer-main">
      <p class="footer-mark">Ethereus</p>
      <p class="footer-disclaimer">
        Research software. Not audited. Do not use with keys that control funds you cannot lose.
      </p>
      <p class="footer-licenses">
        Site content <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a> · Code in this repo <a href="https://opensource.org/license/mit">MIT</a> ·
        Weights <a href="https://www.apache.org/licenses/LICENSE-2.0">Apache-2.0</a> ·
        <a href="/credits">Credits</a> · <a href={REPO} target="_blank" rel="noreferrer">View the code</a>
      </p>
    </div>
    <div class="footer-meta">
      <p class="mono footer-meta-line"><span style="color:var(--ink-faint)">backbone</span> qwen3.5-4b · <span data-updated>2026-10-31</span></p>
    </div>
  </div>
</footer>

<style>
  .footer { border-top: 1px solid var(--border); background: var(--bg-soft); padding: 28px 0 32px; }
  .footer-inner { display: flex; flex-wrap: wrap; gap: 24px 40px; justify-content: space-between; align-items: flex-start; }
  .footer-mark { font-weight: 700; letter-spacing: -0.03em; margin: 0; }
  .footer-disclaimer, .footer-licenses { margin: 6px 0 0; font-size: 0.8rem; color: var(--ink-soft); }
  .footer-licenses a { text-decoration: underline; text-underline-offset: 2px; text-decoration-color: var(--border); }
  .footer-licenses a:hover { text-decoration-color: var(--ink-soft); }
  .footer-meta-line { font-size: 0.74rem; color: var(--ink-soft); margin: 0; }
</style>
