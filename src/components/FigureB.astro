---
// Figure B — "Who writes each token" (themed, inline SVG so it inherits CSS variables)
// Spec: left Qwen, middle circuit (trace → tool_response with calldata), right Qwen.
// Reused half-size on home; full on /how-it-works.
interface Props { compact?: boolean; animate?: boolean }
const { compact = false, animate = true } = Astro.props;
const id = `fig-b-${Math.random().toString(36).slice(2, 7)}`;
---

<figure class:list={["fig-b", { "is-compact": compact }]} role="group" aria-labelledby={`${id}-caption`}>
  <figcaption id={`${id}-caption`} class="kicker" style="margin-bottom:10px">Who writes each token</figcaption>
  <div class:list={["fig-b-stage", { "do-animate": animate }]}>
    <svg viewBox="0 0 860 148" role="img" aria-label="Token stream: Qwen writes the prompt and tool call, the circuit owns the trace and response, Qwen resumes. An approval is only valid on circuit-owned positions." xmlns="http://www.w3.org/2000/svg">
      <!-- track -->
      <rect x="8" y="44" width="844" height="64" rx="12" fill="var(--bg-soft)" stroke="var(--border)" />
      <!-- Qwen left -->
      <rect x="16" y="52" width="262" height="48" rx="8" fill="var(--surface)" stroke="var(--border)" />
      <text x="28" y="68" font-family="Inter, sans-serif" font-size="7.5" font-weight="700" letter-spacing="0.08em" fill="var(--ink-faint)">QWEN</text>
      <text x="28" y="84" font-family="JetBrains Mono, monospace" font-size="8.2" fill="var(--ink-soft)">&lt;tool_call&gt; eth encode …</text>
      <text x="28" y="94" font-family="Inter, sans-serif" font-size="7.6" fill="var(--ink-faint)">…transfer 1.5 USDC to 0xAB…</text>
      <!-- circuit middle -->
      <g class="fig-b-circuit">
        <rect x="286" y="52" width="308" height="48" rx="8" fill="var(--accent-soft)" stroke="var(--accent)" stroke-opacity="0.9" />
        <text x="298" y="68" font-family="Inter, sans-serif" font-size="7.5" font-weight="700" letter-spacing="0.08em" fill="var(--accent-ink)">CIRCUIT — QWEN FROZEN</text>
        <g font-family="JetBrains Mono, monospace" font-size="7.8" fill="var(--ink)">
          <rect x="298" y="73" width="18" height="10" rx="2" fill="var(--ink)" opacity="0.14" /><text x="302" y="81" font-size="5.6" fill="var(--ink)">AD</text>
          <rect x="318" y="73" width="18" height="10" rx="2" fill="var(--ink)" opacity="0.14" /><text x="322" y="81" font-size="5.6" fill="var(--ink)">VL</text>
          <rect x="338" y="73" width="18" height="10" rx="2" fill="var(--ink)" opacity="0.14" /><text x="341" y="81" font-size="5.6" fill="var(--ink)">ST</text>
          <text x="360" y="81" font-size="6.2" fill="var(--ink-faint)">trace tokens →</text>
        </g>
        <text x="298" y="94" font-family="JetBrains Mono, monospace" font-size="8.2" fill="var(--accent-ink)">&lt;tool_response&gt; 0xa9059cbb…</text>
      </g>
      <!-- Qwen right -->
      <rect x="602" y="52" width="242" height="48" rx="8" fill="var(--surface)" stroke="var(--border)" />
      <text x="614" y="68" font-family="Inter, sans-serif" font-size="7.5" font-weight="700" letter-spacing="0.08em" fill="var(--ink-faint)">QWEN</text>
      <text x="614" y="84" font-family="Inter, sans-serif" font-size="8" fill="var(--ink-soft)">The calldata is 0xa9059cbb…</text>
      <text x="614" y="94" font-family="Inter, sans-serif" font-size="7.6" fill="var(--ink-faint)">continues naturally</text>

      <!-- bracket above circuit -->
      <path d="M286 34 L286 28 L594 28 L594 34" fill="none" stroke="var(--ink-faint)" stroke-width="1" opacity="0.9" />
      <text x="440" y="22" text-anchor="middle" font-family="Inter, sans-serif" font-size="7.2" font-weight="600" fill="var(--ink-faint)">circuit-owned positions · Qwen frozen here</text>

      <!-- policy line below -->
      <text x="440" y="128" text-anchor="middle" font-family="Inter, sans-serif" font-size="7.4" font-weight="600" fill="var(--accent-ink)">policy APPROVED can only appear in this segment</text>
      <path d="M312 118 L568 118" stroke="var(--accent)" stroke-width="1" stroke-dasharray="4 4" opacity="0.9" />
      <!-- ownership dots -->
      <circle cx="20" cy="108" r="3" fill="var(--ink-faint)" opacity="0.9" />
      <circle cx="430" cy="108" r="3.2" fill="var(--accent)" />
      <circle cx="720" cy="108" r="3" fill="var(--ink-faint)" opacity="0.9" />
    </svg>
  </div>
  <p class="fig-note">The model calls a tool exactly as it would for any API. No server runs it — the compiled layers read the call, run the firmware, and write the response. Ownership per token is what makes the policy unforgeable.</p>
</figure>

<style>
  .fig-b-stage { overflow-x: auto; }
  .fig-b-stage svg { min-width: 520px; width: 100%; }
  .is-compact .fig-b-stage svg { min-width: 460px; }
  .fig-note { margin: 10px 2px 0; font-size: 0.78rem; color: var(--ink-faint); line-height: 1.5; max-width: 64ch; }

  /* one-shot fill of the circuit segment on scroll-into-view */
  @media (prefers-reduced-motion: no-preference) {
    .do-animate .fig-b-circuit { clip-path: inset(0 100% 0 0); animation: fig-b-reveal 900ms cubic-bezier(.25,.8,.3,1) forwards; animation-timeline: view(); animation-range: entry 10% cover 28%; }
  }
  @keyframes fig-b-reveal { to { clip-path: inset(0 0 0 0); } }
</style>
